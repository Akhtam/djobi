{
  "name": "djobi",
  "version": "1.0.0",
  "description": "Chrome extension that autofills job applications with an AI-tailored resume and drafted answers.",
  "private": true,
  "scripts": {
    "dev:backend": "pnpm --filter backend dev",
    "dev:backend:debug": "pnpm --filter backend dev:debug",
    "dev:extension": "pnpm --filter extension dev",
    "build:extension": "pnpm --filter extension build",
    "dev:dashboard": "pnpm --filter dashboard dev",
    "build:dashboard": "pnpm --filter dashboard build",
    "build:shared": "pnpm --filter @djobi/shared build",
    "db:generate": "pnpm --filter backend db:generate",
    "db:migrate": "pnpm --filter backend db:migrate",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose stop db",
    "db:logs": "docker compose logs -f db",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present run typecheck",
    "build": "pnpm -w run build:packages && pnpm -r --if-present run build",
    "test": "pnpm -r --if-present run test",
    "build:packages": "pnpm --filter @djobi/shared build && pnpm --filter @djobi/http-client build && pnpm --filter @djobi/profile-editor build && pnpm --filter @djobi/manual-log build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.20.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "prettier": "^3.9.6"
  }
}
