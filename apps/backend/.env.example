DATABASE_URL=postgres://user:password@ep-example-123456.us-east-2.aws.neon.tech/djobi?sslmode=require
OPENROUTER_API_KEY=sk-or-v1-...
PORT=5391

# Auth (docs/multi-tenant-auth.md, Phase B). BETTER_AUTH_SECRET signs session tokens and cookies —
# generate one with `openssl rand -base64 32`. BETTER_AUTH_URL is this backend's own origin; leave
# it unset locally to use the default below.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:5391

# Comma-separated real origins (the deployed dashboard's, primarily) to trust in addition to the
# hardcoded localhost pair — read by both `app.ts`'s CORS allowlist and `auth.ts`'s
# `trustedOrigins`. Leave unset locally.
PUBLIC_ORIGINS=

# Set to `production` on a real deploy — gates the session cookie's `Secure` attribute (`auth.ts`).
# Leave unset locally: `Secure` cookies are refused by Safari over plain `http://`.
NODE_ENV=

# Google sign-in. Register an OAuth client in Google Cloud Console (APIs & Services > Credentials),
# type "Web application", and add this exact redirect URI:
#   http://127.0.0.1:5391/api/auth/callback/google
# (swap the origin for BETTER_AUTH_URL's value if you changed it). Email/password sign-in works
# with neither of these set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
