{
  "name": "backend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm -w run build:shared",
    "dev": "tsx watch src/index.ts",
    "predev:debug": "pnpm -w run build:shared",
    "dev:debug": "tsx watch --inspect src/index.ts",
    "prebuild": "pnpm -w run build:shared",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "eval:extraction": "tsx scripts/evalExtraction.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@djobi/shared": "workspace:*",
    "@expo-google-fonts/noto-sans": "^0.4.2",
    "@hono/node-server": "^1.13.7",
    "@neondatabase/serverless": "^0.10.4",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@react-pdf/renderer": "^4.1.5",
    "ai": "^7.0.84",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.3",
    "hono": "^4.6.14",
    "react": "^18.3.1",
    "unpdf": "^1.8.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.5",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
